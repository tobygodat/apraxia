# apraxia cloud runtime template.
# Copy to .env.local for local use. Never commit populated environment files.
# The legacy Python runtime continues to use .env.example during transition.

# Browser-safe Supabase configuration
VITE_APRAXIA_RUNTIME=cloud
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical application origin for this environment
APP_URL=http://127.0.0.1:3000

# Server-only Google OAuth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exactly 32 cryptographically random bytes encoded as padded standard Base64.
# Keep this in a server secret store. Never paste a generated key into docs/chat.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Browser-safe Google Picker configuration. Restrict the API key to the Google
# Picker API and the deployed/local website referrers before using it.
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

# Server-only personal agent API. See docs/AGENT_API.md.
# Dedicated random bearer token (32 random bytes as base64url or 64 hex chars).
# Never give an agent SUPABASE_SERVICE_ROLE_KEY or place these in VITE_* variables.
# Production Vercel still stores this as ORBITOS_AGENT_TOKEN (sensitive variables cannot be
# renamed); the server accepts either name.
APRAXIA_AGENT_TOKEN=
APRAXIA_AGENT_USER_ID=
# Omitted defaults to workspace:read; add only the intended permissions.
APRAXIA_AGENT_SCOPES=workspace:read,workspace:write,calendar:read,calendar:write,files:read
