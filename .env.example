# orbitOS configuration — copy to `.env` and fill in. NEVER commit `.env` (spec §9).
# Every value here is read by src/orbitos/config.py.

# --- Telegram bot (spec §7 step 4) ---------------------------------------
# Create a bot via @BotFather, paste the token, then message the bot and grab
# your numeric chat id. Leave blank in dev to run without Telegram.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Anthropic API (spec §7 step 5) --------------------------------------
# Used by the extractor and the drafting agent. Leave blank in dev to disable
# LLM calls (the pipeline will no-op).
ANTHROPIC_API_KEY=

# --- Paths ----------------------------------------------------------------
# VAULT_PATH: local clone of the Obsidian vault git repo (read-only input).
# DB_PATH:    the single SQLite file — the canonical data store.
VAULT_PATH=./vault
DB_PATH=./orbitos.db

# --- Web app auth (spec §9 — single shared password gate) ----------------
# Leave APP_PASSWORD blank in dev to disable the gate entirely.
# SESSION_SECRET signs the session cookie — set a long random string in prod.
APP_PASSWORD=
SESSION_SECRET=dev-insecure-change-me

# --- Tuning (spec §7 step 8) ---------------------------------------------
SCAN_INTERVAL_MIN=15
CONFIDENCE_THRESHOLD=0.75

# --- Web server -----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# "development" enables CORS for the Vite dev server; "production" serves the
# built SPA from frontend/dist (spec §6 — one service).
ENV=development
