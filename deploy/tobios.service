# systemd unit for tobiOS (spec §6 — one service; §7 step 7).
# Install: copy to /etc/systemd/system/tobios.service, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now tobios
# Logs:    journalctl -u tobios -f

[Unit]
Description=tobiOS personal CRM (web + scheduler + Telegram bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tobios
WorkingDirectory=/opt/tobios
EnvironmentFile=/opt/tobios/.env
# .venv is created by `uv sync`; the package is installed into it.
ExecStart=/opt/tobios/.venv/bin/python -m tobios.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
